rules_version = '2';

// Paste these into Firebase console > Firestore Database > Rules, then click Publish.
// Visitors can only read approved reviews and can only add new, unapproved ones.
// Nobody can edit or delete from the website; you approve/delete reviews in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'role', 'company', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.role is string && request.resource.data.role.size() <= 80
        && request.resource.data.company is string && request.resource.data.company.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 800
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }
  }
}
